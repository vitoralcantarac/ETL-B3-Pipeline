# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env

# Token da API brapi.dev — obtenha em https://brapi.dev
BRAPI_TOKEN=seu_token_aqui

# Supabase — encontre em Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Use a service_role key aqui (bypassa RLS — necessário para o ETL escrever no banco)
# NUNCA use a service_role no Cloudflare Worker ou em qualquer código client-side
# A anon key fica no Cloudflare Worker (configurada via wrangler secret)
SUPABASE_KEY=sua_service_role_key_aqui
